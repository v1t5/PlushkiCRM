{
    "name": "plushki/logger",
    "description": "Logger sentinel — stateless tap on every topic exchange (#), logs each event to stdout.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pcntl": "*",
        "ext-sockets": "*",
        "monolog/monolog": "^3.7",
        "open-telemetry/api": "^1.1",
        "open-telemetry/exporter-otlp": "^1.1",
        "open-telemetry/sdk": "^1.1",
        "php-amqplib/php-amqplib": "^3.7",
        "php-http/discovery": "^1.19",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/yaml": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Plushki\\Logger\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "replace": {
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Plushki\\Logger\\Tests\\": "tests/"
        }
    }
}

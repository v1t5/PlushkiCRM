# PlushkiCRM — environment overrides for docker compose.
#
# Copy to `.env` (which is git-ignored) and change the values before any
# non-local deployment. Every variable below has a built-in default in the
# compose files, so the stack also runs with no `.env` at all — these are
# the dev defaults, kept here only so they are easy to override:
#
#   cp .env.example .env
#
# Compose reads `.env` from the directory you run `docker compose` in (repo root).

# ─── Message broker (RabbitMQ) ───────────────────────────────────────────────
# Used by the broker container and by every service's APP_AMQP_URL.
RABBITMQ_USER=plushki
RABBITMQ_PASSWORD=plushki

# ─── Per-service PostgreSQL credentials ──────────────────────────────────────
# Each service owns an isolated database. The database NAME stays fixed (it is
# tied to the volume); only the login credentials are configurable here.
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity

CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog

ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders

INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory

PRODUCTION_DB_USER=production
PRODUCTION_DB_PASSWORD=production

CRM_DB_USER=crm
CRM_DB_PASSWORD=crm

REPORTING_DB_USER=reporting
REPORTING_DB_PASSWORD=reporting

NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_PASSWORD=notifications

# ─── Identity bootstrap ──────────────────────────────────────────────────────
# Email granted the admin role on identity startup (register it first, then it
# is promoted on the next boot).
BOOTSTRAP_ADMIN_EMAIL=admin@plushki.local

# ─── Telegram (notifications + tg-bot) ───────────────────────────────────────
# Leave TG_BOT_TOKEN empty to run Telegram in dry-run mode (no outbound sends).
# TG_ADMIN_CHAT_ID is the chat that receives inventory low-stock alerts.
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

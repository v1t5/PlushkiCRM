{
    "name": "plushki/production",
    "description": "Production service — daily plan accumulation from orders.v1.confirmed, plan publish + baker task FSM, task_completed recipe snapshot.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.1",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.7",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.1",
        "open-telemetry/exporter-otlp": "^1.1",
        "open-telemetry/sdk": "^1.1",
        "php-amqplib/php-amqplib": "^3.7",
        "php-http/discovery": "^1.19",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/uid": "^7.1",
        "symfony/validator": "^7.1",
        "symfony/yaml": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Plushki\\Production\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        },
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "replace": {
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Plushki\\Production\\Tests\\": "tests/"
        }
    }
}
